# --- Database ---
DATABASE_URL=postgresql://rag:ragpassword@localhost:5432/ragdocs

# --- Embeddings (local by default, no key needed) ---
EMBEDDING_PROVIDER=local-hash
# Options: local-hash | sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Chunking ---
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50

# --- Retrieval ---
TOP_K_VECTOR=20
TOP_K_BM25=20
TOP_K_RERANK=10
TOP_K_FINAL=5
RRF_K=60
BM25_K1=1.5
BM25_B=0.75

# --- Rerank (optional, falls back to local) ---
RERANK_PROVIDER=local
# Options: local | cohere | openai
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0
OPENAI_API_KEY=
OPENAI_RERANK_MODEL=gpt-4o-mini

# --- Generation ---
LLM_PROVIDER=mock
# Options: mock | openai
OPENAI_CHAT_MODEL=gpt-4o-mini
GENERATION_MAX_TOKENS=1024
GENERATION_TEMPERATURE=0.2
ABSTAIN_THRESHOLD=0.35
MIN_CONTEXT_DOCS=1

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
